    "@minecraft/server-ui": "1.2.0-beta.1.21.1-stable",
    "@minecraft/vanilla-data": "1.21.1",
    "esbuild": "^0.23.0",
    "project-lantern": "1.4.4",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "rollup": "^4.18.1"
  }
}
