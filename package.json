{
  "name": "hy2",
  "version": "2.2.1",
  "description": "A Minecraft addon",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --external:@minecraft/server --external:@minecraft/server-ui --minify-syntax \"--outfile=./隐藏之年2(BP)/scripts/index.js\"",
    "buildSrc": "prettier --write src&&tsc",
    "debug": "tsc --noEmit&&prettier --write .",
    "prettier": "prettier --write .",
    "test": "tsc"
  },
  "author": "FangLimao",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@minecraft/server": "^1.12.0-beta.1.21.0-stable",
    "@minecraft/server-ui": "^1.2.0-beta.1.21.0-stable",
    "@minecraft/vanilla-data": "1.21.0",
    "esbuild": "^0.20.2",
    "project-lantern": "1.1.0-rc.2",
    "typescript": "^5.4.5"
  }
}
