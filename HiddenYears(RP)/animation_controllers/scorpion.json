{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.scorpion.attack": {
      "initial_state": "default",
      "states": {
        "attacking": {
          "animations": ["attack"],
          "transitions": [
            {
              "default": "variable.attack_time < 0.0"
            }
          ]
        },
        "default": {
          "animations": ["out_ground"],
          "transitions": [
            {
              "attacking": "variable.attack_time >= 0.0"
            }
          ]
        }
      }
    },
    "controller.animation.scorpion.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": ["out_ground"],
          "transitions": [
            {
              "move": "query.modified_move_speed > 0"
            }
          ]
        },
        "move": {
          "animations": ["out_ground", "move"],
          "transitions": [
            {
              "default": "query.all_animations_finished"
            }
          ]
        }
      }
    }
  }
}
