{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.mutas_wrath.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle" , { "hide_addition": "!query.is_sneaking" }
          ],
          "transitions": [{ "walking": "q.ground_speed > 1.0" }],
          "blend_transition": 0.4,
          "blend_via_shortest_path": true
        },
        "walking": {
          "animations": [
            "move" , { "hide_addition": "!query.is_sneaking" }
          ],
          "transitions": [{ "idle": "q.ground_speed < 0.5" }],
          "blend_transition": 0.4
        }
      }
    }
  }
}
