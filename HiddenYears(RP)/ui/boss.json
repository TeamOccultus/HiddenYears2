{
  "namespace": "boss",

  "empty_progress_bar": {
    "type": "image",
    "layer": 2,
    "texture": "$empty_texture"
  },

  "filled_progress_bar_for_collections": {
    "size": [180, 4],
    "layer": 4,
    "type": "image",
    "texture": "$filled_texture",
    "clip_direction": "left",
    "clip_pixelperfect": false,
    "bindings": [
      {
        "binding_name": "#progress_percentage",
        "binding_name_override": "#clip_ratio",
        "binding_type": "collection",
        "binding_collection_name": "$progress_bar_collection"
      }
    ]
  },

  "progress_bar_for_collections": {
    "type": "panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [188, 26],
    "controls": [
      { "empty@empty_progress_bar": { "layer": 1 } },
      { "filled@filled_progress_bar_for_collections": { "layer": 2 } }
    ]
  },
  "ruby@progress_bar_for_collections": {
    "size": [268, 19],
    "$empty_texture": "textures/ui/ruby_bar_empty",
    "$filled_texture": "textures/ui/ruby_bar_filled",
    "controls": [
      { "empty@empty_progress_bar": { "layer": 1, "size": [268, 19] } },
      {
        "filled@filled_progress_bar_for_collections": {
          "layer": 2,
          "size": [268, 19]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "(#bossName = $(entity.hiddenyears:king_of_ruby.name)",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars",
        "binding_name_override": "#visible"
      }
    ]
  },
  "ghost@progress_bar_for_collections": {
    "size": [268, 15],
    "$empty_texture": "textures/ui/ghost_bar_empty",
    "$filled_texture": "textures/ui/ghost_bar_filled",
    "controls": [
      { "empty@empty_progress_bar": { "layer": 1, "size": [268, 15] } },
      {
        "filled@filled_progress_bar_for_collections": {
          "layer": 2,
          "size": [268, 15]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "(#bossName = $(entity.hiddenyears:pharaohs_ghost.name)",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars",
        "binding_name_override": "#visible"
      }
    ]
  },
  "mutas_wrath@progress_bar_for_collections": {
    "size": [268, 15],
    "$empty_texture": "textures/ui/mutas_wrath_bar_empty",
    "$filled_texture": "textures/ui/mutas_wrath_bar_filled",
    "controls": [
      { "empty@empty_progress_bar": { "layer": 1, "size": [268, 15] } },
      {
        "filled@filled_progress_bar_for_collections": {
          "layer": 2,
          "size": [268, 15]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "(#bossName = $(entity.hiddenyears:mutas_wrath.name)",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars",
        "binding_name_override": "#visible"
      }
    ]
  },
  "dragon@progress_bar_for_collections": {
    "size": [268, 15],
    "$empty_texture": "textures/ui/dragon_bar_empty",
    "$filled_texture": "textures/ui/dragon_bar_filled",
    "controls": [
      { "empty@empty_progress_bar": { "layer": 1, "size": [268, 15] } },
      {
        "filled@filled_progress_bar_for_collections": {
          "layer": 2,
          "size": [268, 15]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "(#bossName = $(entity.ender_dragon.name)",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars",
        "binding_name_override": "#visible"
      }
    ]
  },
  "wither@progress_bar_for_collections": {
    "size": [268, 15],
    "$empty_texture": "textures/ui/wither_bar_empty",
    "$filled_texture": "textures/ui/wither_bar_filled",
    "controls": [
      { "empty@empty_progress_bar": { "layer": 1, "size": [268, 15] } },
      {
        "filled@filled_progress_bar_for_collections": {
          "layer": 2,
          "size": [268, 15]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "(#bossName = $(entity.wither.name)",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars",
        "binding_name_override": "#visible"
      }
    ]
  }
}
