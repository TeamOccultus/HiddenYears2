{
  "namespace": "how_to_play",
  "how_to_play_screen@how_to_play_common.screen_base": {
    "$selector_stack_panel": "how_to_play.selector_stack_panel",
    "$section_content_panels": "how_to_play.section_content_panels",
    "$header_safezone_control": "common_store.store_top_bar_filler",
    "$header_bar_control": "common_store.store_top_bar",
    "$is_full_screen_layout": true
  },
  "selector_stack_panel": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "orientation": "vertical",
    "$default_selector_toggle_index": 2,
    "controls": [
      {
        "how_to_play_selector_pane": {
          "type": "stack_panel",
          "controls": [
            {
              "padding_0": {
                "type": "panel",
                "size": [0, 6]
              }
            },
            {
              "overview_button@how_to_play.overview_button": {
                "$toggle_group_forced_index": 0
              }
            },
            {
              "material_category@how_to_play_common.topic_category": {
                "$category": "material"
              }
            },
            {
              "material_button@hiddenyears:page_material.material_button": {
                "$toggle_group_forced_index": 1
              }
            },
            {
              "material_basic_button@hiddenyears:page_material_basic.material_basic_button": {
                "$toggle_group_forced_index": 2
              }
            },
            {
              "material_advanced_button@hiddenyears:page_material_advanced.material_advanced_button": {
                "$toggle_group_forced_index": 3
              }
            },
            {
              "material_ultimate_button@hiddenyears:page_material_ultimate.material_ultimate_button": {
                "$toggle_group_forced_index": 4
              }
            },
            {
              "nugget_and_dust@hiddenyears:page_nugget_and_dust.nugget_and_dust_button": {
                "$toggle_group_forced_index": 5
              }
            },
            {
              "story_category@how_to_play_common.topic_category": {
                "$category": "story"
              }
            },
            {
              "story_button@hiddenyears:player_story.story_button": {
                "$toggle_group_forced_index": 6
              }
            },
            {
              "about_category@how_to_play_common.topic_category": {
                "$category": "about"
              }
            },
            {
              "credit_button@hiddenyears:page_credit.credit_button": {
                "$toggle_group_forced_index": 7
              }
            },
            {
              "contact_button@hiddenyears:page_contact.contact_button": {
                "$toggle_group_forced_index": 8
              }
            },
            {
              "padding_1@how_to_play_common.padding": {
                "size": [0, 10]
              }
            }
          ]
        }
      }
    ]
  },
  "section_content_panels": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": ["100% - 5px", "100%c + 5px"],
    "offset": [2, 0],
    "controls": [
      {
        "general_tips_sections": {
          "type": "stack_panel",
          "controls": [
            {
              "section_contents_header@how_to_play_common.section_contents_header": {}
            },
            {
              "overview_section@how_to_play.overview_section": {}
            },
            {
              "material_section@hiddenyears:page_material.material_section": {}
            },
            {
              "material_basic_section@hiddenyears:page_material_basic.material_basic_section": {}
            },
            {
              "material_advanced_section@hiddenyears:page_material_advanced.material_advanced_section": {}
            },
            {
              "material_u_section@hiddenyears:page_material_ultimate.material_ultimate_section": {}
            },
            {
              "nugget_and_dust_section@hiddenyears:page_nugget_and_dust.nugget_and_dust_section": {}
            },
            {
              "story_section@hiddenyears:player_story.story_section": {}
            },
            {
              "credit_section@hiddenyears:page_credit.credit_section": {}
            },
            {
              "contact_section@hiddenyears:page_contact.contact_section": {}
            },
            {
              "section_contents_footer@how_to_play_common.section_contents_footer": {}
            }
          ]
        }
      }
    ]
  },
  "overview_button@how_to_play_common.section_toggle_button": {
    "$section_topic": "overview"
  },
  "overview_section@how_to_play_common.main_sections": {
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "overview_button_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "header_0@how_to_play_common.header": {
          "$text": "encyclopedia.header"
        }
      },
      {
        "padding_0@how_to_play_common.padding": {}
      },
      {
        "paragraph_0@how_to_play_common.paragraph": {
          "$text": "encyclopedia.body.1"
        }
      },
      {
        "padding_1@how_to_play_common.padding": {}
      },
      {
        "image_1@how_to_play_common.image": {
          "texture": "textures/ui/credits_hat"
        }
      },
      {
        "paragraph_2@how_to_play_common.paragraph": {
          "$text": "encyclopedia.body.1"
        }
      }
    ]
  }
}
