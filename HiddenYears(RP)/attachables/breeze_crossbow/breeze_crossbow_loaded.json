{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "hiddenyears:breeze_crossbow_loaded",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/breeze_crossbow_pulling_3",
        "bow_pulling_0": "textures/items/breeze_crossbow_pulling_3",
        "bow_pulling_1": "textures/items/breeze_crossbow_pulling_3",
        "bow_pulling_2": "textures/items/breeze_crossbow_pulling_3",
        "enchanted": "textures/misc/enchanted_item_glint"
      },

      "geometry": {
        "default": "geometry.crossbows_standby",
        "bow_pulling_0": "geometry.crossbows_pulling_0",
        "bow_pulling_1": "geometry.crossbows_pulling_1",
        "bow_pulling_2": "geometry.crossbows_pulling_2"
      },
      "animations": {
        "wield": "animation.crossbow.wield",
        "wield_first_person_pull": "animation.crossbow.wield_first_person_pull"
      },
      "scripts": {
        "pre_animation": ["v.charge_amount = 0;"],
        "animate": [
          "wield",
          {
            "wield_first_person_pull": "q.main_hand_item_use_duration > 0.0f && c.is_first_person"
          }
        ]
      },
      "render_controllers": ["controller.render.crossbow"]
