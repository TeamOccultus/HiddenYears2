{
  "include": ["src/**/*"],
  "compilerOptions": {
    "target": "es2022",
    "module": "ES2022",
    "moduleResolution": "node10",
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "types",
    "removeComments": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
