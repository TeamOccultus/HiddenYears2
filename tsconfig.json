{
  "include": ["src/*"],
  "compilerOptions": {
    "target": "es2022",
    "module": "ES2022",
    "moduleResolution": "node10",
    //"declaration": true,
    "outDir": ".gitee/ISSUE_TEMPLATE/隐藏之年2(BP)/scripts",
    "noEmit": true,
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictNullChecks": false,
    "skipLibCheck": true
  }
}
