{
  "name": "HiddenYears2",
  "id": "hiddenyears",
  "metadata": {
    "description": "",
    "author": "Team Occultus",
    "version": "3.0.9-beta.3",
    "contributors": []
  },
  "compilerOptions": {
    "basic": {
      "behavior": "HiddenYears(BP)",
      "resource": "HiddenYears(RP)"
    },
    "typescript": {
      "enable": true,
      "entryPoint": "src/main.ts",
      "engine": "esbuild",
      "output": "HiddenYears(BP)/scripts/main.js",
      "minify": true,
      "sourceMap": "linked"
    },
    "asset": {
      "enable": true,
      "texture": "assets/textures",
      "localization": {
        "path": "assets/lang",
        "type": "JSON"
      }
    },
    "outputDir": "dist",
    "compressLevel": 1
  },
  "deployOptions": {
    "platform": "stable",
    "sources": [
      {
        "path": "HiddenYears(BP)",
        "type": "behavior"
      },
      {
        "path": "HiddenYears(RP)",
        "type": "resource"
      }
    ],
    "gtk": true
  }
}
