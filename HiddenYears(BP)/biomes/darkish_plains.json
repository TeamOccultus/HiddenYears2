{
  "format_version": "1.21.130",
  "minecraft:biome": {
    "description": {
      "identifier": "hiddenyears:darkish_plains"
    },
    "components": {
      "minecraft:replace_biomes": {
        "replacements": [
          {
            "dimension": "minecraft:overworld", //目前只能填主世界overworld
            "targets": ["minecraft:plains"], //自定义生物群系能够替换的原版生物群系目标
            "amount": 0.4, //替换指数间接性地决定了这个自定义生物群系的稀有程度，0.25表示它只会替换25%的平原面积，你也可以改成别的
            "noise_frequency_scale": 1 //数字越小生物群系就越集中，数字太大那就成斑块了
          }
        ]
      },
      "minecraft:climate": {
        "downfall": 0.4, //应该是降雨力度吧？
        "snow_accumulation": [0.0, 0.125], //降雪的，我不常用所以不告诉你（doge）
        "temperature": 0.7 //气温，你可以填负数，代价是雪花飘飘，好像填0.1也会雪花飘飘，这里沙漠的值为2.0到3.0，气温适中的话正常降雨
      },
      "minecraft:overworld_height": {
        "noise_type": "lowlands" //噪声类型为低洼土地，非常适合平原
      },
      "minecraft:surface_builder": {
        "builder": {
          "type": "minecraft:overworld",
          "sea_floor_depth": 7, //海洋深度大伙都填7
          "sea_floor_material": "minecraft:gravel", //海底地基为沙砾，你改掉也不是不行
          "foundation_material": "minecraft:stone", //这一般是泥土下面的方块，平常是石头，你也可以改
          "mid_material": "minecraft:dirt", //中心材料为泥土，也就是地表下面的方块，你可以改
          "top_material": "minecraft:grass_block", //地表方块为草方块，你可以改
          "sea_material": "minecraft:water" //海洋方块为水，如果你想“热”闹一点就填la-la-la-lava～
        }
      },
      "minecraft:tags": {
        //标签，很重要
        "tags": [
          "animal", //这个群系能生成动物
          "monster", //这个群系能生成怪物
          "overworld", //这个群系是主世界的生物群系，请不要删掉它
          "darkish_plains", //你的自定义生物群系标签，你可以利用它来做这个群系专属的地物和生成规则
          "bee_habitat" //蜜蜂的最爱
        ]
      }
    }
  }
} //先到这里，其他的我还在写～JD，6.11
