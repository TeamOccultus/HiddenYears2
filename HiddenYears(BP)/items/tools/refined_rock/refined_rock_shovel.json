{
  "format_version": "1.21.0",
  "minecraft:item": {
    "description": {
      "identifier": "hiddenyears:refined_rock_shovel",
      "menu_category": {
        "category": "equipment",
        "group": "itemGroup.name.shovel"
      }
    },
    "components": {
      "hiddenyears:custom_tools": {
        "type": "shovel"
      },
      "minecraft:max_stack_size": 1,
      "minecraft:hand_equipped": true,
      "minecraft:durability": {
        "max_durability": 120
      },
      "minecraft:damage": 3,
      "minecraft:enchantable": {
        "value": 10,
        "slot": "shovel"
      },
      "minecraft:repairable": {
        "repair_items": [
          {
            "items": ["hiddenyears:refined_rock_ingot"],
            "repair_amount": "query.max_durability * 0.25"
          },
          {
            "items": ["hiddenyears:refined_rock_shovel"],
            "repair_amount": "context.other->query.remaining_durability+0.04*context.other->query.max_durability"
          }
        ]
      },
      "minecraft:digger": {
        "use_efficiency": true,
        "destroy_speeds": [
          {
            "block": {
              "tags": "query.any_tag('minecraft:is_shovel_item_destructible')"
            },
            "speed": 3
          }
        ]
      },
      "minecraft:icon": "hiddenyears:refined_rock_shovel",
      "minecraft:tags": {
        "tags": ["minecraft:is_shovel",  "hiddenyears:refined_rock_tier", "minecraft:stone_tier"]
      }
    }
  }
}
