{
  "format_version": "1.21.100",
  "minecraft:item": {
    "description": {
      "menu_category": {
        "category": "equipment",
        "group": "minecraft:itemGroup.name.pickaxe"
      },
      "identifier": "hiddenyears:silver_pickaxe"
    },
    "components": {
      "hiddenyears:custom_tool": {
        "type": "pickaxe"
      },
      "minecraft:max_stack_size": 1,
      "minecraft:hand_equipped": true,
      "minecraft:durability": {
        "max_durability": 800
      },
      "minecraft:icon": "hiddenyears:silver_pickaxe",
      "minecraft:repairable": {
        "repair_items": [
          {
            "items": ["hiddenyears:silver_pickaxe"],
            "repair_amount": "context.other->query.remaining_durability+0.04*context.other->query.max_durability"
          },
          {
            "items": ["hiddenyears:silver_ingot"],
            "repair_amount": "query.max_durability * 0.25"
          }
        ]
      },
      "minecraft:damage": 5,
      "minecraft:enchantable": {
        "value": 10,
        "slot": "pickaxe"
      },
      "minecraft:digger": {
        "use_efficiency": true,
        "destroy_speeds": [
          {
            "block": {
              "tags": "query.any_tag('minecraft:is_pickaxe_item_destructible') && !query.any_tag('minecraft:iron_tier_destructible', 'minecraft:diamond_tier_destructible')"
            },
            "speed": 7
          }
        ]
      },
      "minecraft:tags": {
        "tags": [
          "minecraft:is_pickaxe",
          "hiddenyears:silver_tier",
          "minecraft:iron_tier"
        ]
      }
    }
  }
}
