{
  "format_version": "1.26.30",
  "minecraft:block": {
    "description": {
      "identifier": "hiddenyears:rebirth_frame",
      "menu_category": {
        "category": "construction"
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"],
          "y_rotation_offset": 180
        }
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 0, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 90, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 180, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": { "rotation": [0, -90, 0] }
        }
      }
    ],
    "components": {
      "minecraft:destruction_particles": {
        "texture": "stone_bricks",
        "particle_count": 30
      },
      "hiddenyears:boss_spawner": {
        "boss": "hiddenyears:pharaohs_ghost",
        "transform_to": "hiddenyears:actived_rebirth_frame",
        "key": "hiddenyears:rebirth_statue",
        "client_events": {
          "sound_event": "item.trident.thunder",
          "title": "title.hiddenyears:pharaohs_ghost",
          "subtitle": "title.hiddenyears:pharaohs_ghost.subtitle"
        },
        "fade": {
          "fade_in": 0.5,
          "hold": 2,
          "fade_out": 2
        }
      },
      "minecraft:loot": "loot_tables/blocks/frames/rebirth_frame.json",
      "minecraft:flammable": false,
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 12,
        "item_specific_speeds": [
          {
            "item": { "tags": "query.any_tag('minecraft:is_pickaxe')" },
            "destroy_speed": 5
          },
          {
            "item": { "tags": "query.any_tag('hiddenyears:is_crowbar')" },
            "destroy_speed": 2
          }
        ]
      },
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "liquid_type": "water",
            "on_liquid_touches": "no_reaction"
          }
        ]
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 10.0
      },
      "minecraft:material_instances": {
        "up": {
          "texture": "hiddenyears:rebirth_frame_top"
        },
        "down": {
          "texture": "hiddenyears:rebirth_frame_bottom"
        },
        "*": {
          "texture": "hiddenyears:rebirth_frame_side"
        }
      },
      "minecraft:geometry": {
        "identifier": "minecraft:geometry.full_block"
      },
      "minecraft:map_color": "#999999"
    }
  }
}
