    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "hiddenyears:adult",
            "hiddenyears:griffin_wild",
            "hiddenyears:ground"
          ]
        }
      },
      "hiddenyears:as_child": {
        "add": {
          "component_groups": [
            "hiddenyears:baby",
            "hiddenyears:griffin_wild",
            "hiddenyears:ground"
          ]
        },
        "remove": {
          "component_groups": ["hiddenyears:adult"]
        }
      },
      "hiddenyears:grow_up": {
        "sequence": [
          {
            "filters": {
              "test": "has_component",
              "value": "minecraft:tameable"
            },
            "add": {
              "component_groups": ["hiddenyears:griffin_rideable"]
            }
          },
          {
            "remove": {
              "component_groups": ["hiddenyears:baby"]
            },
            "add": {
              "component_groups": ["hiddenyears:adult"]
            }
          }
        ]
      },
      "hiddenyears:tame": {
        "sequence": [
          {
            "remove": {
              "component_groups": ["hiddenyears:griffin_wild"]
            },
            "add": {
              "component_groups": ["hiddenyears:tame"]
            }
          },
          {
            "filters": {
              "test": "has_component",
              "operator": "!=",
              "value": "minecraft:is_baby"
            },
            "add": {
              "component_groups": ["hiddenyears:griffin_rideable"]
            }
          }
        ]
      },
      "hiddenyears:saddled": {
        "add": {
          "component_groups": ["hiddenyears:saddled"]
        }
      },
      "hiddenyears:unsaddled": {
        "remove": {
          "component_groups": ["hiddenyears:saddled", "hiddenyears:flying"]
        },
        "queue_command": { "command": ["ride @p stop_riding"] }
      },
      "hiddenyears:add_chest": {
        "add": {
          "component_groups": ["hiddenyears:chested"]
        }
      },
      "hiddenyears:remove_chest": {
        "remove": {
          "component_groups": ["hiddenyears:chested"]
        }
      },
      "fly": {
        "add": { "component_groups": ["hiddenyears:flying"] },
        "remove": {
          "component_groups": ["hiddenyears:ground", "hiddenyears:swimming"]
        },
        "queue_command": {
          "command": ["effect @s slow_falling infinite 0 true"]
        }
      },
      "ground": {
        "sequence": [
          {
            "add": { "component_groups": ["hiddenyears:ground"] },
            "remove": {
              "component_groups": ["hiddenyears:flying", "hiddenyears:swimming"]
            },
            "queue_command": { "command": ["effect @s clear slow_falling "] }
          }
        ]
      },
      "stop": {
        "remove": { "component_groups": ["flying"] },
        "add": { "component_groups": ["hiddenyears:ground"] },
        "queue_command": { "command": ["effect @s clear slow_falling"] }
      },
      "swim": {
        "remove": {
          "component_groups": ["hiddenyears:ground", "hiddenyears:flying"]
        },
        "add": { "component_groups": ["hiddenyears:swimming"] },
        "queue_command": { "command": ["effect @s clear slow_falling "] }
      }
