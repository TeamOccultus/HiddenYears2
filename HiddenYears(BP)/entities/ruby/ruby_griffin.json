          "component_groups": ["hiddenyears:start_flying"]
        },
        "add": {
          "component_groups": ["hiddenyears:stop_flying"]
        }
      },
      "hiddenyears:switch_to_flying": {
        "remove": {
          "component_groups": ["hiddenyears:ground"]
        },
        "add": {
          "component_groups": ["hiddenyears:flying"]
        }
      },
      "hiddenyears:switch_to_ground": {
        "remove": {
          "component_groups": ["hiddenyears:flying"]
        },
        "add": {
