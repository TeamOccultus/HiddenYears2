{
  "format_version": "1.19.0",
  "animation_controllers": {
    "controller.animation.mutas_wrath.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": ["idle"],
          "transitions": [
            {
              "move": "query.modified_move_speed > 0"
            },
            {
              "none": "query.is_item_name_any('slot.weapon.mainhand', 0, 'minecraft:diamond_sword')"
            }
          ]
        },
        "move": {
          "animations": ["idle", "move"],
          "transitions": [
            {
              "default": "query.all_animations_finished"
            },
            {
              "none": "query.is_item_name_any('slot.weapon.mainhand', 0, 'minecraft:diamond_sword')"
            }
          ]
        },
        "none": {
          "animations": ["none"],
          "transitions": [
            {
              "default": "query.all_animations_finished"
            }
          ]
        }
      }
    }
  }
}
