{
  "format_version": "1.21.0",
  "minecraft:item": {
    "description": {
      "identifier": "hy:bone_piece_hoe",
      "menu_category": {
        "category": "equipment",
        "group": "itemGroup.name.hoe"
      }
    },
    "components": {
      "minecraft:display_name": {
        "value": "hy.item.bone_piece_hoe"
      },
      "minecraft:max_stack_size": 1,
      "minecraft:hand_equipped": true,
      "minecraft:durability": {
        "max_durability": 160
      },
      "minecraft:damage": 4,
      "minecraft:enchantable": {
        "value": 10,
        "slot": "hoe"
      },
      "minecraft:repairable": {
        "repair_items": [
          {
            "items": ["hy:bone_piece_hoe"],
            "repair_amount": "context.other->query.remaining_durability+0.04*context.other->query.max_durability"
          },
          {
            "items": ["hy:bone_piece"],
            "repair_amount": "query.max_durability * 0.25"
          }
        ]
      },
      "minecraft:icon": "hy.bone_piece_hoe",
      "minecraft:digger": {
        "use_efficiency": true,
        "destroy_speeds": [
          {
            "block": {
              "tags": "query.any_tag('minecraft:is_hoe_item_destructible')"
            },
            "speed": 4
          }
        ]
      },
      "minecraft:tags": {
        "tags": ["hy:custom_tools", "minecraft:is_hoe", "hy:custom_hoe"]
      }
    }
  }
}
