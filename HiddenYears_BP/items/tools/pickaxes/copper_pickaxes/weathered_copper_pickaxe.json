{
  "format_version": "1.21.0",
  "minecraft:item": {
    "description": {
      "menu_category": {
        "category": "equipment",
        "group": "itemGroup.name.pickaxe"
      },
      "identifier": "hy:weathered_copper_pickaxe"
    },
    "components": {
      "minecraft:display_name": {
        "value": "%hy.item.weathered_copper_pickaxe\n\n%hy.miningBlessed.desc"
      },
      "minecraft:max_stack_size": 1,
      "minecraft:hand_equipped": true,
      "minecraft:durability": {
        "max_durability": 30
      },
      "minecraft:icon": "hy:weathered_copper_pickaxe",
      "minecraft:repairable": {
        "repair_items": [
          {
            "items": [
              "hy:copper_pickaxe",
              "hy:exposed_copper_pickaxe",
              "hy:weathered_copper_pickaxe",
              "hy:oxidized_copper_pickaxe"
            ],
            "repair_amount": "context.other->query.remaining_durability+0.04*context.other->query.max_durability"
          },
          {
            "items": ["copper_ingot"],
            "repair_amount": "query.max_durability * 0.25"
          }
        ]
      },
      "minecraft:damage": 2,
      "minecraft:enchantable": {
        "value": 8,
        "slot": "pickaxe"
      },
      "minecraft:digger": {
        "use_efficiency": true,
        "destroy_speeds": [
          {
            "block": {
              "tags": "query.all_tags('minecraft:is_pickaxe_item_destructible', 'minecraft:iron_tier_destructible')"
            },
            "speed": 1
          },
          {
            "block": {
              "tags": "query.all_tags('minecraft:is_pickaxe_item_destructible', 'minecraft:diamond_tier_destructible')"
            },
            "speed": 1
          },
          {
            "block": {
              "tags": "query.any_tag('minecraft:is_pickaxe_item_destructible')"
            },
            "speed": 3
          }
        ]
      },
      "minecraft:tags": {
        "tags": [
          "hy:custom_tools",
          "minecraft:is_pickaxe",
          "hy:corrosive_tools",
          "hy:weathered_item",
          "minecraft:stone_tier",
          "hy:copper_tier"
        ]
      }
    }
  }
}
