{
  "format_version": "1.21.0",
  "minecraft:item": {
    "description": {
      "menu_category": {
        "category": "equipment",
        "group": "itemGroup.name.pickaxe"
      },
      "identifier": "hy:over_metal_pickaxe"
    },
    "components": {
      "minecraft:display_name": {
        "value": "hy.item.over_metal_pickaxe"
      },
      "minecraft:max_stack_size": 1,
      "minecraft:hand_equipped": true,
      "minecraft:durability": {
        "max_durability": 200
      },
      "minecraft:icon": "hy.over_metal_pickaxe",
      "minecraft:repairable": {
        "repair_items": [
          {
            "items": ["hy:over_metal_pickaxe"],
            "repair_amount": "context.other->query.remaining_durability+0.04*context.other->query.max_durability"
          },
          {
            "items": ["hy:over_metal_ingot"],
            "repair_amount": "query.max_durability * 0.25"
          }
        ]
      },
      "minecraft:damage": 4,
      "minecraft:enchantable": {
        "value": 15,
        "slot": "pickaxe"
      },
      "minecraft:digger": {
        "use_efficiency": true,
        "destroy_speeds": [
          {
            "block": {
              "tags": "query.all_tags('minecraft:is_pickaxe_item_destructible', 'minecraft:stone_tier_destructible')"
            },
            "speed": 5
          },
          {
            "block": {
              "tags": "query.any_tag('stone')"
            },
            "speed": 5
          }
        ]
      },
      "minecraft:tags": {
        "tags": ["hy:custom_tools", "minecraft:is_pickaxe", "minecraft:stone_tier", "hy:stone_metal_tier"]
      }
    }
  }
}
