{
  "format_version": "1.21.0",
  "minecraft:item": {
    "description": {
      "menu_category": {
        "category": "equipment",
        "group": "itemGroup.name.pickaxe"
      },
      "identifier": "hy:corrosion_pickaxe"
    },
    "components": {
      "minecraft:display_name": {
        "value": "%hy.item.corrosion_pickaxe\n\n%hy.miningBlessed.desc"
      },
      "minecraft:max_stack_size": 1,
      "minecraft:hand_equipped": true,
      "minecraft:durability": {
        "max_durability": 300
      },
      "minecraft:icon": "hy:exposed_copper_pickaxe",
      "minecraft:repairable": {
        "repair_items": [
          {
            "items": ["hy:corrosion_ingot"],
            "repair_amount": 40
          },
          {
            "items": ["hy:corrosion_pickaxe"],
            "repair_amount": "context.other->query.remaining_durability+0.05*context.other->query.max_durability"
          }
        ]
      },
      "minecraft:damage": 5,
      "minecraft:enchantable": {
        "value": 8,
        "slot": "pickaxe"
      },
      "minecraft:digger": {
        "use_efficiency": true,
        "destroy_speeds": [
          {
            "block": {
              "tags": "query.all_tags('minecraft:is_pickaxe_item_destructible', 'minecraft:diamond_tier_destructible')"
            },
            "speed": 1
          },
          {
            "block": {
              "tags": "query.any_tag('minecraft:is_pickaxe_item_destructible')"
            },
            "speed": 6
          }
        ]
      },
      "minecraft:tags": {
        "tags": [
          "hy:custom_tools",
          "minecraft:is_pickaxe",
          "hy:corrosion_tier",
          "hy:iron_tier"
        ]
      }
    }
  }
}
