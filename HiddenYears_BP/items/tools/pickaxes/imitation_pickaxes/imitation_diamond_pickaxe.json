{
  "format_version": "1.21.0",
  "minecraft:item": {
    "description": {
      "menu_category": {
        "category": "equipment",
        "group": "itemGroup.name.pickaxe"
      },
      "identifier": "hy:imitation_diamond_pickaxe"
    },
    "components": {
      "minecraft:display_name": {
        "value": "%hy.item.imitation_diamond_pickaxe\n\n%hy.miningCurse.desc"
      },
      "minecraft:max_stack_size": 1,
      "minecraft:hover_text_color": "gold",
      "minecraft:hand_equipped": true,
      "minecraft:durability": {
        "max_durability": 780
      },
      "minecraft:icon": "hy:imitation_diamond_pickaxe",
      "minecraft:repairable": {
        "repair_items": [
          {
            "items": ["hy:imitation_diamond_pickaxe"],
            "repair_amount": "context.other->query.remaining_durability+0.04*context.other->query.max_durability"
          },
          {
            "items": ["hy:imitation_diamond"],
            "repair_amount": 5
          }
        ]
      },
      "minecraft:damage": 4,
      "minecraft:enchantable": {
        "value": 1,
        "slot": "pickaxe"
      },
      "minecraft:digger": {
        "use_efficiency": true,
        "destroy_speeds": [
          {
            "block": {
              "tags": "query.any_tag('minecraft:is_pickaxe_item_destructible')"
            },
            "speed": 8
          }
        ]
      },
      "minecraft:tags": {
        "tags": [
          "hy:custom_tools",
          "minecraft:is_pickaxe",
          "hy:imitation_tools"
        ]
      }
    }
  }
}
