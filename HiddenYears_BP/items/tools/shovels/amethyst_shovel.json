{
  "format_version": "1.21.0",
  "minecraft:item": {
    "description": {
      "identifier": "hy:amethyst_shovel",
      "menu_category": {
        "category": "equipment",
        "group": "itemGroup.name.shovel"
      }
    },
    "components": {
      "minecraft:display_name": {
        "value": "hy.item.amethyst_shovel"
      },
      "minecraft:max_stack_size": 1,
      "minecraft:hand_equipped": true,
      "minecraft:durability": {
        "max_durability": 200
      },
      "minecraft:damage": 3,
      "minecraft:enchantable": {
        "value": 114,
        "slot": "shovel"
      },
      "minecraft:repairable": {
        "repair_items": [
          {
            "items": ["hy:amethyst_ingot"],
            "repair_amount": "query.max_durability * 0.25"
          },
          {
            "items": ["hy:amethyst_shovel"],
            "repair_amount": "context.other->query.remaining_durability+0.04*context.other->query.max_durability"
          }
        ]
      },
      "minecraft:digger": {
        "use_efficiency": true,
        "destroy_speeds": [
          {
            "block": {
              "tags": "query.any_tag('minecraft:is_shovel_item_destructible')"
            },
            "speed": 5
          }
        ]
      },
      "minecraft:icon": "hy:amethyst_shovel",
      "minecraft:tags": {
        "tags": [
          "hy:custom_tools",
          "minecraft:is_shovel",
          "hy:custom_shovel",
          "minecraft:stone_tier",
          "hy:amethyst_tier"
        ]
      }
    }
  }
}
